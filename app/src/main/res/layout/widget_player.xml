<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="22dp" android:text="Serein" android:textSize="13sp" android:textColor="#687b57" android:fontFamily="sans-serif-medium" />
        <Chronometer android:id="@+id/widget_timer_live" android:layout_width="wrap_content" android:layout_height="28dp" android:textSize="12sp" android:textColor="#536746" android:fontFamily="sans-serif-medium" android:gravity="center" android:visibility="gone" />
        <TextView android:id="@+id/widget_timer_label" android:layout_width="wrap_content" android:layout_height="28dp" android:text="Timer" android:textColor="#687b57" android:textSize="11sp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="4dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sleep" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.03" android:textColor="#35432c" android:maxLines="1" android:ellipsize="end" />
        <ImageButton android:id="@+id/widget_play" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp" android:scaleType="fitCenter" android:background="@drawable/widget_button" android:src="@drawable/ic_widget_play" android:contentDescription="Play" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/widget_sleep" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Sleep" android:textColor="#536746" android:textSize="11sp" android:gravity="center" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/widget_focus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="7dp" android:text="Focus" android:textColor="#536746" android:textSize="11sp" android:gravity="center" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/widget_unwind" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="7dp" android:text="Unwind" android:textColor="#536746" android:textSize="11sp" android:gravity="center" android:background="@drawable/widget_button" />
    </LinearLayout>
</LinearLayout>
