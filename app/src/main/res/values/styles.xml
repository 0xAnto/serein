        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#b5c5a0</item>
        <item name="android:textColorPrimary">#cfd8c8</item>
        <item name="android:textColorSecondary">#a1af99</item>
        <item name="android:windowBackground">#252c28</item>
        <item name="android:statusBarColor">#252c28</item>
